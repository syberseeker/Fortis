# Fortis environment overrides. Real environment variables always win over
# this file; keys that are not recognized are logged as ignored at startup.
# The LLM is llama.cpp on a local GGUF (engine/) — no Ollama, no cloud APIs.

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MAX_CONTEXT_TOKENS=6000

# ---- RAG upgrade ----
# Retrieval tier: basic = dense-only; standard = + hybrid BM25/RRF, chunk
# enrichment, heuristic query condensation (no extra LLM call); full = + LLM
# condensation and cross-encoder reranking (auto-disabled below 8GB RAM).
RAG_LEVEL=standard
# Cross-encoder reranker backend; 'none' disables reranking entirely.
RERANK_BACKEND=sentence-transformers
# Optional: HF model id for the reranker (default BAAI/bge-reranker-base).
#RERANK_MODEL=BAAI/bge-reranker-base
